# port the Hono server runs on
PORT=5000

# URL of the frontend application
FRONTEND_URL="http://localhost:3000"

# Secret key for Better Auth
BETTER_AUTH_SECRET= # to generate use command 'openssl rand -base64 32'

# Base backend url for Better Auth
